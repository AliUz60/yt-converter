# MediaFlow Çevre Değişkenleri
# Bu dosyayı .env.local olarak kopyalayın

# Uygulama URL'si (tarayıcı tarafı için)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API güvenlik anahtarı (isteğe bağlı)
# Üretim kullanımı için gerçek arka uç işçisi gereklidir
API_SECRET_KEY=your-api-secret-key

# Harici medya işleme servisi (örneğin kendi FFmpeg sunucunuz)
# Bu değer, gerçek MP3/MP4 dönüştürme için gereklidir
WORKER_URL=https://your-worker-service.example.com
WORKER_API_KEY=your-worker-api-key