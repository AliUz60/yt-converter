# MediaFlow Çevre Değişkenleri (.env.local)
# Üretim için değerleri değiştirin

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Not: Bu değerler sadece demo içindir.
# Gerçek MP3/MP4 dönüştürme için bir medya işleme servisi gereklidir.
# Detaylar için README.md dosyasına bakın.

API_SECRET_KEY=mediaflow-demo-secret-key
WORKER_URL=https://example-worker-url.com/work
WORKER_API_KEY=demo-worker-key